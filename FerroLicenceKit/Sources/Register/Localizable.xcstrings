          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ heeft schema %2$lld; deze app leest schema 2"
          }
        }
      }
    },
    "%@ is already trusted." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
