{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ already exists; a licence is recorded once." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bestaat al; een licentie wordt één keer vastgelegd."
          }
        }
      }
    },
    "%@ has broken self-bindings" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ heeft kapotte zelfbindingen"
          }
        }
      }
    },
    "%@ has schema %lld; this app reads schema 2" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ has schema %2$lld; this app reads schema 2"
