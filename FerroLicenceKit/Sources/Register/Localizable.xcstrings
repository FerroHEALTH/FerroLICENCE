        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is geen vertrouwde sleutel."
          }
        }
      }
    },
    "FerroEHR refuses it at the check “%@”." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FerroEHR weigert het bij de controle “%@”."
