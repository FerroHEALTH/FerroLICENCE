      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overgedragen"
          }
        }
      }
    },
    "Ignored; the server runs on the free licence." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genegeerd; de server draait op de gratis licentie."
