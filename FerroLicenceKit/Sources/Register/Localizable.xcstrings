    },
    "Not valid yet. It starts on %@." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog niet geldig. Hij begint op %@."
          }
        }
      }
    },
    "Remove the tab or line break from the reason." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijder de tab of regelovergang uit de reden."
          }
        }
      }
    },
    "Remove the tab or line break from the text." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijder de tab of regelovergang uit de tekst."
          }
        }
      }
    },
    "Retired" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingetrokken"
          }
        }
      }
    },
    "Say why, for example the contract clause or the letter." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeg waarom, bijvoorbeeld het contractartikel of de brief."
          }
        }
      }
    },
    "Signed by a retired key (%@, %@). FerroEHR no longer trusts it." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Signed by a retired key (%1$@, %2$@). FerroEHR no longer trusts it."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ondertekend met een ingetrokken sleutel (%1$@, %2$@). FerroEHR vertrouwt hem niet meer."
          }
        }
      }
    },
    "That file is not a key from Set Up a YubiKey." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dat bestand is geen sleutel uit Stel een YubiKey in."
          }
        }
      }
    },
    "The Register check refuses it: %@. Nothing was recorded." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De Register check weigert het: %@. Er is niets vastgelegd."
          }
        }
      }
    },
    "The file was changed after it was signed." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het bestand is na het ondertekenen gewijzigd."
          }
        }
      }
    },
    "The key file gives no GitHub login." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het sleutelbestand noemt geen GitHub-login."
          }
        }
      }
    },
    "The last day comes before the first day." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De laatste dag valt vóór de eerste dag."
          }
        }
      }
    },
    "The licence already ended on %@; there is nothing to revoke." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De licentie is al afgelopen op %@; er is niets in te trekken."
          }
        }
      }
    },
    "The licence only starts on %@; pick that day or later." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De licentie begint pas op %@; kies die dag of later."
          }
        }
      }
    },
    "The licence this renews (%@) is not in the register." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De licentie die hiermee wordt verlengd (%@) staat niet in het register."
          }
        }
      }
    },
    "The name is longer than %lld characters." : {
      "localizations" : {
