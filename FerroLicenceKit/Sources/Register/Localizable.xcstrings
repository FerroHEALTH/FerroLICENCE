        }
      }
    },
    "In Use" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In gebruik"
          }
        }
      }
    },
    "In force; the server reports it." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Van kracht; de server meldt het."
          }
        }
      }
    },
    "Lost" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kwijt"
          }
        }
      }
    },
    "Name the person who holds the key." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noem de persoon die de sleutel heeft."
          }
        }
      }
    },
