                }
              }
            }
          }
        }
      }
    },
    "The signed licence differs from the draft. Nothing was recorded." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De ondertekende licentie wijkt af van het concept. Er is niets vastgelegd."
          }
        }
      }
    },
    "The signed licence fails FerroEHR's check “%@”. Nothing was recorded." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De ondertekende licentie haalt de controle “%@” van FerroEHR niet. Er is niets vastgelegd."
          }
        }
      }
    },
    "This is the last trusted key; set up another YubiKey first." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit is de laatste vertrouwde sleutel; stel eerst een andere YubiKey in."
          }
        }
      }
    },
    "This key signs nothing new already; it can only be retired." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze sleutel ondertekent al niets nieuws meer; hij kan alleen nog worden ingetrokken."
          }
        }
      }
    },
    "This licence is already revoked." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze licentie is al ingetrokken."
          }
        }
      }
    },
    "Trust the successor's key first, so a key stays in use." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertrouw eerst de sleutel van de opvolger, zodat er een sleutel in gebruik blijft."
          }
        }
      }
    },
    "Type the customer's legal name, as in the agreement." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Typ de juridische naam van de klant, zoals in de overeenkomst."
          }
        }
      }
    },
    "Valid on %@, until %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
